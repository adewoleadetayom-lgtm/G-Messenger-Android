{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "gmIds": {
      "$gmId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "messages": {
      "$conversation": {
        "$message": {
          ".read": "auth != null && (data.child('from').val() === auth.uid || data.child('to').val() === auth.uid)",
          ".write": "auth != null && newData.child('from').val() === auth.uid"
        }
      }
    }
  }
}
